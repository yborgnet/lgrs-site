---
import type { TopoStage } from "../../data/topos/types";

type Props = { profile: [number, number, number][]; stages: TopoStage[]; title: string; dayLabel: string; locale: string };
const { profile, stages, title, dayLabel, locale } = Astro.props;

const W = 1000, H = 240, PAD_L = 44, PAD_R = 8, PAD_T = 26, PAD_B = 22;
const maxKm = profile[profile.length - 1][0];
const eles = profile.map((p) => p[1]);
const minE = Math.floor((Math.min(...eles) - 100) / 500) * 500;
const maxE = Math.ceil((Math.max(...eles) + 100) / 500) * 500;
const x = (km: number) => PAD_L + (km / maxKm) * (W - PAD_L - PAD_R);
const y = (e: number) => PAD_T + (1 - (e - minE) / (maxE - minE)) * (H - PAD_T - PAD_B);
const line = profile.map((p, i) => `${i ? "L" : "M"}${x(p[0]).toFixed(1)},${y(p[1]).toFixed(1)}`).join("");
const area = `${line}L${x(maxKm).toFixed(1)},${H - PAD_B}L${PAD_L},${H - PAD_B}Z`;
const ticks: number[] = [];
for (let e = minE; e <= maxE; e += 500) ticks.push(e);
// Limites d'étapes : premier point de chaque journée.
const bounds = stages.map((s) => {
  const pts = profile.filter((p) => p[2] === s.day - 1);
  return { start: pts[0][0], end: pts[pts.length - 1][0] };
});
const nf = new Intl.NumberFormat(locale, { useGrouping: "always" });
---

<figure class="topo-profile">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="none">
    {ticks.map((e) => (
      <g>
        <line x1={PAD_L} x2={W - PAD_R} y1={y(e)} y2={y(e)} class="topo-profile__grid" />
        <text x={PAD_L - 6} y={y(e) + 3} class="topo-profile__tick" text-anchor="end">{nf.format(e)}</text>
      </g>
    ))}
    <path d={area} class="topo-profile__area" />
    <path d={line} class="topo-profile__line" />
    {bounds.map((b, i) => (
      <g>
        {i > 0 && <line x1={x(b.start)} x2={x(b.start)} y1={PAD_T - 14} y2={H - PAD_B} class="topo-profile__sep" />}
        <text x={(x(b.start) + x(b.end)) / 2} y={PAD_T - 12} class="topo-profile__day" text-anchor="middle">{dayLabel}{stages[i].day}</text>
      </g>
    ))}
  </svg>
  <ol class="topo-profile__days" style={`grid-template-columns:${bounds.map((b) => `${(b.end - b.start).toFixed(2)}fr`).join(" ")}`}>
    {stages.map((s) => (
      <li>
        <span>{dayLabel}{s.day}</span>
        <strong>D+ {nf.format(s.ascentM)}&nbsp;m</strong>
      </li>
    ))}
  </ol>
</figure>
