---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import TopoFooter from "./TopoFooter.astro";
import "../../styles/editorial.css";
import "../../styles/topo.css";
import { withBase } from "../../lib/url";
import { getLang, localizedHref, routeFor } from "../../i18n/utils";
import { topoUi, locales } from "../../i18n/topo";
import { topos } from "../../data/topos/index";

const lang = getLang(Astro.currentLocale);
const u = topoUi[lang];
const nf = new Intl.NumberFormat(locales[lang], { useGrouping: "always" });
const km = (n: number) => new Intl.NumberFormat(locales[lang], { maximumFractionDigits: 0 }).format(n);
const canonical = `https://lesgrandsraidsaski.com${routeFor(lang, "/topos/")}`;
const seo = {
  fr: { title: "Topos : grandes traversées à ski et voies ouvertes | Les Grands Raids à Ski", description: "Topos de grandes traversées à ski de randonnée et de voies ouvertes par Yann Borgnet : cartes, traces GPX, étapes, dénivelés, refuges et contacts. Informations factuelles pour préparer un raid à ski." },
  en: { title: "Topos: long ski traverses and new routes | Les Grands Raids à Ski", description: "Topos of long ski touring traverses and routes first climbed by Yann Borgnet: maps, GPX tracks, stages, ascent, huts and contacts. Factual information to prepare a hut-to-hut ski trip." },
  it: { title: "Topo: grandi traversate con gli sci e vie aperte | Les Grands Raids à Ski", description: "Topo di grandi traversate scialpinistiche e di vie aperte da Yann Borgnet: mappe, tracce GPX, tappe, dislivelli, rifugi e contatti. Informazioni per preparare un raid con gli sci." },
}[lang];
const [t1, t2] = u.indexTitle.split(", ");
---

<BaseLayout title={seo.title} description={seo.description} canonical={canonical} ogImage={topos.find((t) => t.photoHero)?.photoHero?.src}>
  <Header solid />
  <main class="topo">
    <section class="ed-section ed-section--paper topos-index-hero">
      <div class="site-shell">
        <p class="ed-eyebrow">{u.indexEyebrow}</p>
        <h1>{t1}, <em>{t2}</em></h1>
        <p class="lead">{u.indexLead}</p>
      </div>
    </section>
    <section class="ed-section ed-section--white">
      <div class="site-shell">
        <ul class="topo-cards">
          {topos.map((t) => (
            <li class="topo-card">
              <a href={localizedHref(lang, `/topos/${t.slug}/`)}>
                {t.photoHero ? (
                  <div class="topo-card__media">
                    <img src={withBase(t.photoHero.src)} alt={t.photoHero.alt[lang]} width={t.photoHero.width} height={t.photoHero.height} loading="lazy" decoding="async" />
                    <span class="topo-badge">{u.badge}{t.type === "voie" ? ` · ${u.voie}` : ""}</span>
                  </div>
                ) : (
                  <div class="topo-card__media topo-card__media--plain">
                    <span>{t.summit.name}</span>
                    <span class="topo-badge">{u.badge} · {u.voie}</span>
                  </div>
                )}
                <h2>{t.name[lang]}</h2>
                <p class="topo-card__sub">{t.subtitle[lang]}</p>
                <ul class="topo-card__data topo-mono">
                  <li>{t.massif[lang]} · {t.country[lang]}</li>
                  {t.type === "voie" ? (
                    <>
                      <li>{nf.format(t.lengthM)} {u.lengthUnit}</li>
                      <li>{t.maxGrade}</li>
                      <li>{t.summit.name} {nf.format(t.summit.ele)} m</li>
                      <li>{u.opened} {t.openedYear}</li>
                    </>
                  ) : (
                    <>
                      <li>{t.stats.days} {u.days}</li>
                      <li>{km(t.stats.distanceKm)} km</li>
                      <li>D+ {nf.format(t.stats.ascentM)} m</li>
                      <li>{t.stats.highPoint.name} {nf.format(t.stats.highPoint.ele)} m</li>
                    </>
                  )}
                </ul>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <TopoFooter />
</BaseLayout>
