---
import { mediterraneenRaids, raidsSection } from "../../data/voyages/mediterraneenRaids";
import { withBase } from "../../lib/url";
import "../../styles/mediterraneen-raids.css";
---

<section class="mraids">
  <div class="site-shell mraids__inner">
    <header class="mraids__head">
      <p class="eyebrow">{raidsSection.eyebrow}</p>
      <h2>{raidsSection.title}</h2>
      <p class="mraids__intro">{raidsSection.intro}</p>
    </header>

    {
      mediterraneenRaids.map((raid, i) => (
        <article class:list={["mraid", i % 2 === 1 && "mraid--reverse"]} id={raid.id}>
          <header class="mraid__head">
            <p class="mraid__country">{raid.country}</p>
            <h3 class="mraid__name">{raid.name}</h3>
          </header>

          <div class="mraid__photo">
            {raid.photo ? (
              <img src={withBase(raid.photo.src)} alt={raid.photo.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="mraid__photo-placeholder">
                <span>Photo à venir</span>
              </div>
            )}
          </div>

          <div class="mraid__body">
            <p class="mraid__intro">{raid.intro}</p>
            <p class="mraid__keyline">{raid.keyline}</p>
            <ul class="mraid__keyextra">
              {raid.keyExtra.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            <p class="mraid__axis">{raid.axis}</p>
          </div>

          <ol class="mraid__days">
            {raid.days.map((day) => (
              <>
                {day.part && <li class="mraid__part">{day.part}</li>}
                <li class="mraid-day">
                  <span class="mraid-day__num">{day.num}</span>
                  <div class="mraid-day__main">
                    <h4>{day.title}</h4>
                    {day.stats && <p class="mraid-day__stats">{day.stats}</p>}
                    {day.text && <p class="mraid-day__text">{day.text}</p>}
                    {day.alert && <p class="mraid-day__alert">{day.alert}</p>}
                    <p class="mraid-day__night">
                      <strong>{day.nightLabel ?? "Nuit"}</strong> · {day.night}
                    </p>
                  </div>
                </li>
                {day.link && <li class="mraid__link">{day.link}</li>}
              </>
            ))}
          </ol>

          <div class="mraid__lodging">
            <span>{raid.lodgingLabel}</span>
            <p>{raid.lodging}</p>
          </div>

          <p class="mraid__note">{raidsSection.disclaimer}</p>
        </article>
      ))
    }
  </div>
</section>
