---
import { withBase } from "../lib/url";
type Props = {
  solid?: boolean;
};

const { solid = false } = Astro.props;
---

<header class:list={["site-header", { "site-header--solid": solid }]}>
  <div class="site-shell site-header__inner">
    <a class="site-brand" href={withBase("/")}>
      <span>LES GRANDS RAIDS</span>
      <small>À SKI</small>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <a href={withBase("/prochains-voyages/")}>Voyages</a>
      <a href={withBase("/philosophie/")}>Philosophie</a>
      <a href={withBase("/carnets-de-voyage-ski/")}>Carnets</a>
      <a href={withBase("/contact/")}>Contact</a>
    </nav>

    <details class="site-nav-mobile">
      <summary aria-label="Ouvrir le menu">
        <span></span>
        <span></span>
      </summary>

      <div class="site-nav-mobile__panel">
        <a href={withBase("/prochains-voyages/")}>Voyages</a>
        <a href={withBase("/philosophie/")}>Philosophie</a>
        <a href={withBase("/carnets-de-voyage-ski/")}>Carnets</a>
        <a href={withBase("/contact/")}>Contact</a>
      </div>
    </details>

  </div>
</header>
