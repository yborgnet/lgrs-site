---
type Props = {
  solid?: boolean;
};

const { solid = false } = Astro.props;
---

<header class:list={["site-header", { "site-header--solid": solid }]}>
  <div class="site-shell site-header__inner">
    <a class="site-brand" href="/">
      <span>LES GRANDS RAIDS</span>
      <small>À SKI</small>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <a href="#">Voyages</a>
      <a href="#">Philosophie</a>
      <a href="#">Carnets</a>
      <a href="#">Contact</a>
    </nav>

    <details class="site-nav-mobile">
      <summary aria-label="Ouvrir le menu">
        <span></span>
        <span></span>
      </summary>

      <div class="site-nav-mobile__panel">
        <a href="/prochains-voyages/">Voyages</a>
        <a href="/philosophie/">Philosophie</a>
        <a href="/carnets-de-voyage-ski/">Carnets</a>
        <a href="/contact/">Contact</a>
      </div>
    </details>

  </div>
</header>
