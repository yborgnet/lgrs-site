---
import "../styles/gpx-map.css";
import { withBase } from "../lib/url";

type Props = {
  /** Chemin(s) public(s) vers le(s) fichier(s) GPX, ex. "/gpx/georgie-petit-caucase-2027.gpx". */
  gpx: string | string[];
  /** Description accessible de la carte, ex. « Carte de l'itinéraire du voyage à ski en Géorgie – Petit Caucase ». */
  title: string;
  /** Image statique affichée tant que la carte interactive n'est pas chargée (et si le GPX est introuvable). */
  fallback?: { src: string; alt: string };
};

const { gpx, title, fallback } = Astro.props;
const gpxList = (Array.isArray(gpx) ? gpx : [gpx]).map(withBase);
---

<div class="gpx-map" data-gpx-map data-gpx={JSON.stringify(gpxList)}>
  <div class="gpx-map__canvas" data-gpx-map-canvas role="group" aria-label={title}>
    {fallback && <img src={withBase(fallback.src)} alt={fallback.alt} loading="lazy" decoding="async" />}
  </div>
</div>

<script>
  // Carte Leaflet + trace(s) GPX — chargée uniquement quand la carte approche du viewport,
  // et seulement si la page contient effectivement une carte (import dynamique de Leaflet).
  const MAX_ZOOM = 11; // plafond volontairement serré : la carte situe l'itinéraire, elle ne remplace pas une carte topo détaillée
  const FIT_PADDING: [number, number] = [32, 32];
  const BOUNDS_PAD = 0.22; // marge de déplacement autorisée autour de la trace (fraction de la taille des bounds)
  // Écart (m) entre la fin d'un <trkseg> et le début du suivant au-delà duquel on trace
  // un transfert (portion non skiée, ex. taxi/véhicule) plutôt qu'un simple raccord visuel.
  const TRANSFER_GAP_METERS = 250;

  function haversineMeters(a: [number, number], b: [number, number]): number {
    const R = 6371000;
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(b[0] - a[0]);
    const dLon = toRad(b[1] - a[1]);
    const lat1 = toRad(a[0]);
    const lat2 = toRad(b[0]);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }

  /** Un tableau de segments (un par <trkseg> natif du GPX) — jamais aplati : la
   *  segmentation d'origine porte l'info "portion réellement skiée" (voir
   *  docs/gpx-methodology.md). Rien n'est reconstruit entre deux segments : un écart
   *  réel entre la fin de l'un et le début du suivant reste un écart (transfert),
   *  jamais une portion de trace inventée.
   *  `:scope > trkpt` (enfants directs uniquement) plutôt que `querySelectorAll`
   *  (tous les descendants) : au moins un GPX du site (Géorgie) a des <trkseg>
   *  imbriqués par erreur (fermetures manquantes puis toutes regroupées en fin de
   *  fichier) — avec les descendants, chaque segment "avalerait" tous les suivants. */
  function parseGpxSegments(xmlText: string): [number, number][][] {
    const doc = new DOMParser().parseFromString(xmlText, "application/xml");
    if (doc.querySelector("parsererror")) return [];
    return [...doc.querySelectorAll("trkseg")]
      .map((seg) =>
        [...seg.querySelectorAll(":scope > trkpt")]
          .map((pt) => {
            const lat = parseFloat(pt.getAttribute("lat") ?? "");
            const lon = parseFloat(pt.getAttribute("lon") ?? "");
            return Number.isFinite(lat) && Number.isFinite(lon) ? ([lat, lon] as [number, number]) : null;
          })
          .filter((p): p is [number, number] => p !== null)
      )
      .filter((seg) => seg.length > 1);
  }

  async function initMap(container: HTMLElement) {
    const canvas = container.querySelector<HTMLElement>("[data-gpx-map-canvas]");
    if (!canvas) return;

    let files: string[] = [];
    try {
      files = JSON.parse(container.dataset.gpx ?? "[]");
    } catch {
      files = [];
    }
    if (!files.length) return;

    const perFile = await Promise.all(
      files.map(async (url) => {
        try {
          const res = await fetch(url);
          if (!res.ok) return [];
          return parseGpxSegments(await res.text());
        } catch {
          return [];
        }
      })
    );

    // Tous les segments de tous les fichiers, mis bout à bout dans l'ordre — la
    // continuité (ou non) entre deux segments consécutifs est évaluée plus bas.
    const segments = perFile.flat();
    if (!segments.length) {
      // Pas de trace exploitable : on garde l'image de secours déjà affichée, sans erreur visible.
      return;
    }

    const [{ default: L }] = await Promise.all([import("leaflet"), import("leaflet/dist/leaflet.css")]);

    canvas.replaceChildren();

    const map = L.map(canvas, {
      scrollWheelZoom: false,
      zoomControl: true,
      maxZoom: MAX_ZOOM,
    });

    L.tileLayer("https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png", {
      maxZoom: MAX_ZOOM,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, ' +
        '<a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)',
    }).addTo(map);

    const bounds = L.latLngBounds([]);

    segments.forEach((latlngs, i) => {
      L.polyline(latlngs, {
        color: "#ff2d00",
        weight: 3.6,
        opacity: 1,
        lineJoin: "round",
      }).addTo(map);
      bounds.extend(latlngs);

      // Écart avec le segment précédent : au-delà du seuil, c'est un transfert
      // (taxi/véhicule) — matérialisé par un trait discret, jamais par une trace ski.
      if (i > 0) {
        const prevEnd = segments[i - 1][segments[i - 1].length - 1];
        const start = latlngs[0];
        if (haversineMeters(prevEnd, start) > TRANSFER_GAP_METERS) {
          L.polyline([prevEnd, start], {
            color: "#111111",
            weight: 2.5,
            opacity: 0.9,
            dashArray: "7 7",
            lineCap: "round",
          }).addTo(map);
        }
      }
    });

    const start = segments[0][0];
    const end = segments[segments.length - 1][segments[segments.length - 1].length - 1];
    const markerStyle = { radius: 6, color: "#111111", weight: 2, fillColor: "#ffffff", fillOpacity: 1 };
    L.circleMarker(start, markerStyle).addTo(map);
    L.circleMarker(end, markerStyle).addTo(map);

    map.fitBounds(bounds, { padding: FIT_PADDING, maxZoom: MAX_ZOOM });
    map.setMaxBounds(bounds.pad(BOUNDS_PAD));

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => map.invalidateSize(), 150);
    });
  }

  function bootGpxMaps() {
    const containers = document.querySelectorAll<HTMLElement>("[data-gpx-map]");
    if (!containers.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            obs.unobserve(entry.target);
            initMap(entry.target as HTMLElement);
          }
        }
      },
      { rootMargin: "200px" }
    );

    containers.forEach((el) => observer.observe(el));
  }

  bootGpxMaps();
</script>
