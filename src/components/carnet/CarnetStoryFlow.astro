---
// Récit complet en fil continu : texte à gauche, photos du passage à droite
// (jamais déplié par un bouton). Sur mobile : une seule colonne, les photos
// s'intercalent entre les blocs de texte. Le lightbox navigue dans toutes les
// photos du récit, dans l'ordre de lecture.
import type { Carnet, CarnetPhoto } from "../../data/carnets/types";
import CarnetLightbox from "./CarnetLightbox.astro";
import { withBase } from "../../lib/url";

type Props = {
  story: Carnet["story"];
};

const { story } = Astro.props;
const bodyId = "carnet-flow-body";

const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// *mot* → <em>mot</em> (seul balisage admis dans les paragraphes)
const inline = (s: string) => escapeHtml(s).replace(/\*([^*]+)\*/g, "<em>$1</em>");

const isTall = (p: CarnetPhoto) => !!p.width && !!p.height && p.width < p.height;

// Rail en 2 colonnes : une photo verticale occupe deux rangées (deux photos
// horizontales à côté), wide = toute la largeur.
function railItems(photos: CarnetPhoto[]) {
  return photos.map((photo) => ({
    photo,
    wide: !!photo.wide,
    tall: !photo.wide && isTall(photo),
  }));
}

function photoStyle(photo: CarnetPhoto): string | undefined {
  if (!photo.cropRatio) return undefined;
  return `aspect-ratio: ${photo.cropRatio}; object-fit: cover;${photo.position ? ` object-position: ${photo.position};` : ""}`;
}
---

<section class="carnet-story carnet-flow" data-carnet-gallery>
  <div class="site-shell">
    <p class="carnet-story__eyebrow">{story.eyebrow}</p>
    <h2 class="carnet-flow__heading">{story.toggleLabel}</h2>
    {story.title && <h3 class="carnet-flow__title">{story.title}</h3>}
    {story.byline && <p class="carnet-flow__byline">{story.byline}</p>}
    {story.standfirst && <p class="carnet-flow__standfirst">{story.standfirst}</p>}

    <div class="carnet-flow__collapse" data-flow-collapse>
    <div class="carnet-flow__body" id={bodyId} data-lightbox-gallery>
      {
        story.sections.map((section) => (
          <div class="carnet-flow__chunk">
            <div class="carnet-flow__text">
              {section.heading && <h3>{section.heading}</h3>}
              {section.paragraphs.map((p) => <p set:html={inline(p)} />)}
            </div>
            {section.photos && section.photos.length > 0 && (
              <div class="carnet-flow__rail">
                {railItems(section.photos).map(({ photo, wide, tall }) => (
                  <figure class:list={["carnet-flow__item", { "carnet-flow__item--wide": wide, "carnet-flow__item--tall": tall }]}>
                    {photo.noZoom ? (
                      <img
                        src={withBase(photo.src)}
                        alt={photo.alt}
                        width={photo.width}
                        height={photo.height}
                        loading="lazy"
                        decoding="async"
                        style={photoStyle(photo)}
                      />
                    ) : (
                      <button
                        type="button"
                        class="carnet-story__photo-trigger"
                        data-lightbox-trigger
                        data-caption={photo.caption ?? ""}
                        aria-label={`Agrandir la photo : ${photo.alt}`}
                      >
                        <img
                          src={withBase(photo.src)}
                          alt={photo.alt}
                          width={photo.width}
                          height={photo.height}
                          loading="lazy"
                          decoding="async"
                          style={photoStyle(photo)}
                        />
                      </button>
                    )}
                  </figure>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
    </div>
    <button type="button" class="carnet-flow__more" data-flow-toggle aria-expanded="false" aria-controls={bodyId} hidden>
      <span data-flow-label>Lire la suite du récit</span>
      <span class="carnet-story__arrow" aria-hidden="true">↓</span>
    </button>

    {story.sourceNote && (
      <footer class="carnet-story__source-note">
        <p>
          {story.sourceNote.text}
          {" "}
          <a href={story.sourceNote.href}>{story.sourceNote.linkLabel}</a>
        </p>
      </footer>
    )}
    {story.closingLinks && story.closingLinks.length > 0 && (
      <footer class="carnet-story__closing-links">
        <ul>
          {story.closingLinks.map((link) => (
            <li>
              {link.href ? (
                <a href={link.href.startsWith("http") ? link.href : withBase(link.href)}>{link.label}</a>
              ) : (
                <span class="carnet-story__closing-links-placeholder">{link.label}</span>
              )}
            </li>
          ))}
        </ul>
      </footer>
    )}
  </div>

  <CarnetLightbox />
</section>

<script>
  // Aperçu replié (~15 lignes) + bouton ; sans JS le récit reste entièrement lisible.
  document.querySelectorAll<HTMLElement>("[data-flow-collapse]").forEach((box) => {
    const section = box.closest(".carnet-flow");
    const btn = section?.querySelector<HTMLButtonElement>("[data-flow-toggle]");
    const label = btn?.querySelector<HTMLElement>("[data-flow-label]");
    if (!section || !btn || !label) return;
    section.classList.add("is-collapsible", "is-collapsed");
    btn.hidden = false;
    btn.addEventListener("click", () => {
      const open = section.classList.toggle("is-collapsed") === false;
      btn.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Réduire le récit" : "Lire la suite du récit";
      btn.querySelector(".carnet-story__arrow")?.classList.toggle("is-open", open);
      if (!open) section.scrollIntoView({ block: "start" });
    });
  });
</script>
