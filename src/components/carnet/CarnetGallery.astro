---
import type { Carnet, CarnetPhoto } from "../../data/carnets/types";
import CarnetLightbox from "./CarnetLightbox.astro";
import { withBase } from "../../lib/url";

type Props = {
  portfolio: Carnet["portfolio"];
};

const { portfolio } = Astro.props;

// Éditorial, propre à chaque carnet (voir Carnet.portfolio.initialPortfolioCount) :
// la première mosaïque doit se terminer proprement visuellement, pas tomber
// sur un compte mécanique. 15 reste le repère par défaut. En dessous de ce
// compte, aucun bouton n'apparaît (comportement inchangé pour les carnets
// existants qui n'ont pas encore cette richesse).
const VISIBLE_COUNT = portfolio?.initialPortfolioCount ?? 15;

function photoStyle(photo: CarnetPhoto): string | undefined {
  if (!photo.cropRatio) return undefined;
  return `aspect-ratio: ${photo.cropRatio}; object-fit: cover;${photo.position ? ` object-position: ${photo.position};` : ""}`;
}
---

{
  portfolio && (
    <section class="carnet-portfolio" data-carnet-gallery>
      <div class="site-shell">
        <div class="carnet-portfolio__head">
          <p class="carnet-portfolio__eyebrow">{portfolio.eyebrow}</p>
          <h2>{portfolio.title}</h2>
          {portfolio.subtitle && <p class="carnet-portfolio__subtitle">{portfolio.subtitle}</p>}
          {portfolio.meta && <p class="carnet-portfolio__meta">{portfolio.meta}</p>}
        </div>

        <div class="carnet-portfolio__masonry" id="carnet-portfolio-grid" data-lightbox-gallery>
          {portfolio.photos.map((photo, i) => (
            <figure class="carnet-portfolio__item" hidden={i >= VISIBLE_COUNT ? true : undefined} data-portfolio-extra={i >= VISIBLE_COUNT ? "" : undefined}>
              <button
                type="button"
                class="carnet-portfolio__trigger"
                data-lightbox-trigger
                data-caption={photo.caption ?? ""}
                aria-label={`Agrandir la photo : ${photo.alt}`}
              >
                <img
                  src={withBase(photo.src)}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                  style={photoStyle(photo)}
                />
              </button>
            </figure>
          ))}
        </div>

        {portfolio.photos.length > VISIBLE_COUNT && (
          <div class="carnet-portfolio__more">
            <button
              type="button"
              class="carnet-portfolio__more-toggle"
              data-portfolio-toggle
              aria-expanded="false"
              aria-controls="carnet-portfolio-grid"
            >
              Voir la suite du portfolio ↓
            </button>
          </div>
        )}
      </div>

      <CarnetLightbox />
    </section>
  )
}

<script>
  function initPortfolioToggle(section: HTMLElement) {
    const toggle = section.querySelector<HTMLButtonElement>("[data-portfolio-toggle]");
    if (!toggle) return;
    const extra = [...section.querySelectorAll<HTMLElement>("[data-portfolio-extra]")];

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      extra.forEach((el) => {
        if (expanded) el.setAttribute("hidden", "");
        else el.removeAttribute("hidden");
      });
      toggle.setAttribute("aria-expanded", String(!expanded));
      toggle.textContent = expanded ? "Voir la suite du portfolio ↓" : "Réduire le portfolio ↑";
    });
  }

  document.querySelectorAll<HTMLElement>(".carnet-portfolio").forEach(initPortfolioToggle);
</script>
