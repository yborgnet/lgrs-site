---
import type { Carnet } from "../../data/carnets/types";

type Props = {
  portfolio: Carnet["portfolio"];
};

const { portfolio } = Astro.props;
---

{
  portfolio && (
    <section class="carnet-portfolio" data-carnet-gallery>
      <div class="site-shell">
        <div class="carnet-portfolio__head">
          <p class="carnet-portfolio__eyebrow">{portfolio.eyebrow}</p>
          <h2>{portfolio.title}</h2>
          {portfolio.meta && <p class="carnet-portfolio__meta">{portfolio.meta}</p>}
        </div>

        <div class="carnet-portfolio__grid" data-lightbox-gallery>
          {portfolio.photos.map((photo, i) => (
            <figure class="carnet-portfolio__item">
              <button
                type="button"
                class="carnet-portfolio__trigger"
                data-lightbox-trigger
                data-index={i}
                data-caption={photo.caption ?? ""}
                aria-label={`Agrandir la photo : ${photo.alt}`}
              >
                <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
              </button>
            </figure>
          ))}
        </div>
      </div>

      {/* Lightbox plein écran — une instance par galerie, structure prête pour
          le swipe mobile à venir (les gestes s'accrocheront à .carnet-lightbox__stage). */}
      <div class="carnet-lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Photo en grand">
        <button type="button" class="carnet-lightbox__close" data-lightbox-close aria-label="Fermer">✕</button>
        <button type="button" class="carnet-lightbox__nav carnet-lightbox__nav--prev" data-lightbox-prev aria-label="Photo précédente">‹</button>
        <button type="button" class="carnet-lightbox__nav carnet-lightbox__nav--next" data-lightbox-next aria-label="Photo suivante">›</button>
        <div class="carnet-lightbox__stage" data-lightbox-stage>
          <img class="carnet-lightbox__image" data-lightbox-image alt="" />
          <p class="carnet-lightbox__caption" data-lightbox-caption hidden></p>
          <p class="carnet-lightbox__counter" data-lightbox-counter></p>
        </div>
      </div>
    </section>
  )
}

<script>
  function initLightbox(gallerySection: HTMLElement) {
    const grid = gallerySection.querySelector<HTMLElement>("[data-lightbox-gallery]");
    const lightbox = gallerySection.querySelector<HTMLElement>("[data-lightbox]");
    if (!grid || !lightbox) return;

    const triggers = [...grid.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")];
    if (!triggers.length) return;

    const photos = triggers.map((btn) => {
      const img = btn.querySelector("img")!;
      return { src: img.src, alt: img.alt, caption: btn.dataset.caption ?? "" };
    });

    const stage = lightbox.querySelector<HTMLElement>("[data-lightbox-stage]")!;
    const imageEl = lightbox.querySelector<HTMLImageElement>("[data-lightbox-image]")!;
    const captionEl = lightbox.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const counterEl = lightbox.querySelector<HTMLElement>("[data-lightbox-counter]")!;
    const closeBtn = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-close]")!;
    const prevBtn = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-prev]")!;
    const nextBtn = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-next]")!;

    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function preload(index: number) {
      const photo = photos[(index + photos.length) % photos.length];
      const img = new Image();
      img.src = photo.src;
    }

    function render() {
      const photo = photos[currentIndex];
      imageEl.src = photo.src;
      imageEl.alt = photo.alt;
      if (photo.caption) {
        captionEl.textContent = photo.caption;
        captionEl.hidden = false;
      } else {
        captionEl.textContent = "";
        captionEl.hidden = true;
      }
      counterEl.textContent = `${currentIndex + 1} / ${photos.length}`;
      preload(currentIndex + 1);
      preload(currentIndex - 1);
    }

    function open(index: number) {
      currentIndex = index;
      lastFocused = document.activeElement as HTMLElement | null;
      render();
      lightbox.hidden = false;
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
      document.addEventListener("keydown", onKeydown);
    }

    function close() {
      lightbox.hidden = true;
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeydown);
      lastFocused?.focus();
    }

    function step(delta: number) {
      currentIndex = (currentIndex + delta + photos.length) % photos.length;
      render();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    }

    triggers.forEach((btn, i) => btn.addEventListener("click", () => open(i)));
    closeBtn.addEventListener("click", close);
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));

    // Clic hors de l'image (fond ou zone de la stage autour du contenu) ferme.
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === stage) close();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-carnet-gallery]").forEach(initLightbox);
</script>
