:root {
  --ink: #0b0b0a;
  --paper: #f3f1ec;
  --warm: #d6a17a;
  --line: rgba(11, 11, 10, 0.16);
  --white: #ffffff;

  --font-sans: "Manrope", sans-serif;
  --font-serif: "Newsreader", serif;

  --shell: min(1360px, calc(100vw - 48px));
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-shell {
  width: var(--shell);
  margin-inline: auto;
}

/* HEADER */

.site-header {
  position: absolute;
  inset: 0 0 auto;
  z-index: 20;
  color: white;
}

.site-header__inner {
  min-height: 92px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-brand {
  display: flex;
  flex-direction: column;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: 0.08em;
}

.site-brand small {
  font-family: var(--font-serif);
  font-size: 14px;
  font-style: italic;
  font-weight: 400;
  letter-spacing: 0;
}

.site-nav {
  display: flex;
  gap: 32px;
  font-size: 13px;
  font-weight: 500;
}

/* HERO */

.hero {
  position: relative;
  min-height: 100svh;
  color: white;
  overflow: hidden;
}

.hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero__veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, rgba(0,0,0,.30), rgba(0,0,0,.08) 40%, rgba(0,0,0,.34)),
    linear-gradient(to right, rgba(0,0,0,.18), transparent 55%);
}

.hero__content {
  position: relative;
  z-index: 2;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding-bottom: 9vh;
}

.hero__kicker {
  margin-bottom: 18px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .18em;
}

.hero h1 {
  margin: 0;
  max-width: 950px;
  font-family: var(--font-sans);
  font-size: clamp(58px, 8.6vw, 138px);
  line-height: .82;
  letter-spacing: -.055em;
  font-weight: 500;
}

.hero h1 em {
  font-family: var(--font-serif);
  font-size: 0.9em;
  font-weight: 300;
}

.hero__tagline {
  margin: 26px 0 0;
  font-family: var(--font-serif);
  font-size: clamp(19px, 2vw, 30px);
  font-weight: 300;
  font-style: italic;
}

/* TEST SECTION */

.intro {
  padding: 110px 0;
}

.intro__eyebrow {
  margin-bottom: 24px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.intro h2 {
  margin: 0;
  max-width: 900px;
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(48px, 7vw, 100px);
  line-height: .95;
  letter-spacing: -.04em;
}

@media (max-width: 700px) {
  :root {
    --shell: calc(100vw - 40px);
  }

  .site-header__inner {
    min-height: 72px;
  }

  .site-nav {
    display: none;
  }

  .hero__content {
    padding-bottom: 11vh;
  }

  .hero h1 {
    font-size: clamp(55px, 17vw, 82px);
  }

  .hero__tagline {
    max-width: 280px;
  }

  .intro {
    padding: 72px 0;
  }
}

/* Ajustements desktop */
@media (min-width: 701px) {
  .site-brand {
    font-size: 22px;
  }

  .site-brand small {
    font-size: 19px;
  }

  .site-nav {
    font-size: 19px;
    gap: 38px;
  }

  .hero__kicker {
    font-size: 19px;
    letter-spacing: .15em;
  }
}
python3 - <<'PY'
from pathlib import Path

# ============================================================
# 1. REMPLACER L'ACCUEIL À PARTIR DE "UNE CERTAINE IDÉE..."
#    SANS TOUCHER AU HERO AU-DESSUS
# ============================================================

page = Path("src/pages/index.astro")
s = page.read_text(encoding="utf-8")

marker = '<section class="intro-section"'
if marker not in s:
    raise SystemExit("Je ne trouve pas la section intro-section dans index.astro")

start = s.index(marker)
end_main = s.index("</main>", start) + len("</main>")

prefix = s[:start]
tail = s[end_main:]

# Si un footer a déjà été ajouté précédemment, on le retire
# pour éviter un doublon.
footer_start = tail.find('<footer class="site-footer"')
if footer_start != -1:
    footer_end = tail.find("</footer>", footer_start)
    if footer_end != -1:
        footer_end += len("</footer>")
        tail = tail[:footer_start] + tail[footer_end:]

