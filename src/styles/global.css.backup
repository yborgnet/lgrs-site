# ============================================================
# 2. CSS UNIQUEMENT POUR CE QUI EST APRÈS LE HERO
#    ON CONSERVE TOUT TON CSS MANUEL AU-DESSUS
# ============================================================

css_file = Path("src/styles/global.css")
css = css_file.read_text(encoding="utf-8")

css_marker = "/* === ACCUEIL DEPUIS PHILOSOPHIE === */"

if css_marker in css:
    css = css.split(css_marker)[0].rstrip() + "\n\n"

css += r'''
/* === ACCUEIL DEPUIS PHILOSOPHIE === */

.home-screen {
  min-height: 100svh;
}

.eyebrow {
  margin: 0 0 26px;
  font-size: 13px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.eyebrow--warm {
  color: var(--warm);
}

.home-text-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 5px;
  border-bottom: 1px solid currentColor;
  font-size: 14px;
  font-weight: 600;
}

.home-button {
  display: inline-flex;
  padding: 15px 20px;
  background: var(--ink);
  color: white;
  font-size: 13px;
  font-weight: 600;
}


/* --------------------------------
   PHILOSOPHIE
   -------------------------------- */

.intro-section {
  display: flex;
  align-items: center;
  background: var(--ink);
  color: var(--paper);
  padding: 80px 0;
}

.intro-grid {
  display: grid;
  grid-template-columns: 1.15fr .75fr;
  gap: 100px;
  align-items: center;
}

.intro-section h2 {
  margin: 0;
  font-size: clamp(68px, 7.4vw, 118px);
  line-height: .88;
  letter-spacing: -.055em;
  font-weight: 500;
}

.intro-section h2 em {
  font-family: var(--font-serif);
  font-weight: 300;
}

.intro-copy {
  max-width: 520px;
}

.intro-copy p {
  margin: 0 0 28px;
  font-size: 18px;
  line-height: 1.65;
}

.intro-copy__lead {
  font-family: var(--font-serif);
  font-size: 30px !important;
  font-weight: 300;
  line-height: 1.28 !important;
}


/* --------------------------------
   VOYAGES 2027
   -------------------------------- */

.voyages-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 0;
  background: var(--paper);
  color: var(--ink);
}

.voyages-heading {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 80px;
  align-items: end;
  margin-bottom: 52px;
}

.voyages-heading h2 {
  margin: 0;
  font-size: clamp(58px, 6vw, 96px);
  line-height: .90;
  letter-spacing: -.05em;
  font-weight: 500;
}

.voyages-heading h2 em {
  font-family: var(--font-serif);
  font-weight: 300;
}

.voyages-heading__intro {
  max-width: 560px;
  margin: 0;
  font-family: var(--font-serif);
  font-size: 25px;
  line-height: 1.35;
  font-weight: 300;
}

.voyages-grid {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 70px;
}

.voyages-visual {
  position: relative;
  overflow: hidden;
}

.voyages-visual > img {
  width: 100%;
  height: 100%;
  min-height: 500px;
  object-fit: cover;
}

.voyages-visual__caption {
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 26px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  color: white;
}

.voyages-visual__caption span {
  font-family: var(--font-serif);
  font-size: 58px;
  font-weight: 300;
}

.voyages-visual__caption p {
  margin: 0;
  text-align: right;
  font-size: 14px;
  line-height: 1.4;
}

.voyages-list {
  display: flex;
  flex-direction: column;
}

.voyage-row {
  display: grid;
  grid-template-columns: 125px 1fr 28px;
  gap: 22px;
  align-items: center;
  min-height: 82px;
  border-top: 1px solid var(--line);
}

.voyage-row:last-of-type {
  border-bottom: 1px solid var(--line);
}

.voyage-row__date {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .04em;
}

.voyage-row__body {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.voyage-row__body strong {
  font-size: 17px;
  font-weight: 600;
}

.voyage-row__body small {
  font-family: var(--font-serif);
  font-size: 16px;
  font-weight: 300;
}

.voyage-row__arrow {
  font-size: 20px;
  transition: transform .2s ease;
}

.voyage-row:hover .voyage-row__arrow {
  transform: translate(4px, -4px);
}

.voyages-actions {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 30px;
}


/* --------------------------------
   GRANDE PHOTO
   -------------------------------- */

.photo-break {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: white;
}

.photo-break > img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-break__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.28);
}

.photo-break__content {
  position: relative;
  z-index: 2;
}

.photo-break blockquote {
  max-width: 1050px;
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(52px, 6.2vw, 100px);
  line-height: .98;
  letter-spacing: -.04em;
  font-weight: 300;
}


/* --------------------------------
   MÉTHODE
   -------------------------------- */

.method-section {
  display: flex;
  align-items: center;
  padding: 90px 0;
  background: var(--paper);
}

.method-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 70px;
}

.method-card {
  padding-top: 25px;
  border-top: 1px solid var(--ink);
}

.method-card > span {
  font-family: var(--font-serif);
  font-size: 17px;
}

.method-card h3 {
  margin: 90px 0 22px;
  font-family: var(--font-serif);
  font-size: clamp(46px, 4vw, 72px);
  line-height: 1;
  font-weight: 300;
}

.method-card p {
  max-width: 360px;
  margin: 0;
  font-size: 17px;
  line-height: 1.6;
}


/* --------------------------------
   CARNETS
   -------------------------------- */

.carnets-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 0;
  background: #e5e2dc;
}

.section-heading-row {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
  margin-bottom: 48px;
}

.section-heading-row h2 {
  margin: 0;
  font-size: clamp(56px, 5.8vw, 92px);
  line-height: .93;
  letter-spacing: -.05em;
  font-weight: 500;
}

.section-heading-row h2 em {
  font-family: var(--font-serif);
  font-weight: 300;
}

.story-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 34px;
}

.story-card__image {
  display: block;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  margin-bottom: 24px;
}

.story-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.story-card:hover .story-card__image img {
  transform: scale(1.025);
}

.story-card .eyebrow {
  margin-bottom: 12px;
  font-size: 10px;
}

.story-card h3 {
  margin: 0 0 13px;
  font-size: 21px;
}

.story-card > p:last-child {
  margin: 0;
  font-family: var(--font-serif);
  font-size: 17px;
  line-height: 1.45;
}


/* --------------------------------
   YANN
   -------------------------------- */

.about-section {
  display: flex;
  align-items: center;
  padding: 80px 0;
  background: var(--paper);
}

.about-grid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 100px;
  align-items: center;
}

.about-photo {
  overflow: hidden;
  max-height: 78svh;
}

.about-photo img {
  width: 100%;
  height: 78svh;
  object-fit: cover;
}

.about-copy {
  max-width: 650px;
}

.about-copy h2 {
  margin: 0 0 40px;
  font-size: clamp(76px, 8vw, 130px);
  line-height: .80;
  letter-spacing: -.06em;
  font-weight: 500;
}

.about-copy h2 em {
  font-family: var(--font-serif);
  font-weight: 300;
}

.about-copy p {
  max-width: 570px;
  font-size: 18px;
  line-height: 1.65;
}

.about-copy__lead {
  font-family: var(--font-serif);
  font-size: 30px !important;
  line-height: 1.3 !important;
  font-weight: 300;
}


/* --------------------------------
   FOOTER
   -------------------------------- */

.site-footer {
  padding: 70px 0 28px;
  background: var(--ink);
  color: var(--paper);
}

.site-footer__grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 70px;
  padding-bottom: 80px;
}

.site-footer__statement {
  max-width: 720px;
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(32px, 3.5vw, 56px);
  line-height: 1.05;
  font-weight: 300;
}

.site-footer__links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 16px;
}

.site-footer__bottom {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding-top: 22px;
  border-top: 1px solid rgba(255,255,255,.18);
  font-size: 12px;
}


/* --------------------------------
   MOBILE
   -------------------------------- */

@media (max-width: 800px) {

  .home-screen {
    min-height: auto;
  }

  .intro-section,
  .voyages-section,
  .method-section,
  .carnets-section,
  .about-section {
    padding: 72px 0;
  }

  .intro-grid {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .intro-section h2 {
    font-size: clamp(52px, 15vw, 78px);
  }

  .intro-copy__lead {
    font-size: 25px !important;
  }

  .voyages-heading {
    grid-template-columns: 1fr;
    gap: 28px;
    margin-bottom: 38px;
  }

  .voyages-heading h2 {
    font-size: 56px;
  }

  .voyages-heading__intro {
    font-size: 21px;
  }

  .voyages-grid {
    grid-template-columns: 1fr;
    gap: 38px;
  }

  .voyages-visual > img {
    min-height: 430px;
  }

  .voyages-visual__caption span {
    font-size: 48px;
  }

  .voyage-row {
    grid-template-columns: 82px 1fr 20px;
    gap: 12px;
    min-height: 0;
    padding: 15px 0;
  }

  .voyage-row__date {
    font-size: 10px;
  }

  .voyage-row__body strong {
    font-size: 14px;
  }

  .voyage-row__body small {
    font-size: 14px;
  }

  .voyages-actions {
    flex-direction: column;
    align-items: flex-start;
  }

  .photo-break {
    min-height: 100svh;
  }

  .photo-break blockquote {
    font-size: clamp(47px, 13vw, 70px);
  }

  .method-grid {
    grid-template-columns: 1fr;
    gap: 55px;
  }

  .method-card h3 {
    margin-top: 42px;
  }

  .section-heading-row {
    display: block;
  }

  .section-heading-row h2 {
    margin-bottom: 30px;
    font-size: 51px;
  }

  .story-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .about-photo {
    max-height: none;
  }

  .about-photo img {
    height: auto;
  }

  .about-copy h2 {
    font-size: 78px;
  }

  .site-footer__grid {
    grid-template-columns: 1fr;
    gap: 45px;
    padding-bottom: 55px;
  }

  .site-footer__bottom {
    flex-direction: column;
    gap: 8px;
  }
}
'''

css_file.write_text(css, encoding="utf-8")

print("✅ Accueil reconstruit depuis « UNE CERTAINE IDÉE DU VOYAGE ».")
print("✅ Hero et réglages manuels situés au-dessus conservés.")
