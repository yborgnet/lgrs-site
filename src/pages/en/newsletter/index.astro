---
import { getLang, localizedHref } from "../../../i18n/utils";
const lang = getLang(Astro.currentLocale);
import SponsorStrip from "../../../components/shared/SponsorStrip.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import "../../../styles/contact.css";
import "../../../styles/contact-popup.css";
import { withBase } from "../../../lib/url";
import { contact } from "../../../data/en/contact";
import { NEWSLETTER_ENDPOINT } from "../../../config/newsletter";

/**
 * Page d'inscription à la newsletter, à partager en lien direct (Facebook,
 * Instagram, WhatsApp). Même envoi vers Brevo que le pop-up
 * (components/shared/ContactPopup.astro), mise en page de /contact/.
 * Le pop-up est désactivé ici (prop popup={false}) pour ne pas doublonner.
 */
const canonical = "https://lesgrandsraidsaski.com/en/newsletter/";
---

<BaseLayout
  title={"Newsletter | Les Grands Raids à Ski"}
  description={"Hear about upcoming departures and newly available places with Les Grands Raids à Ski: one or two letters each season, with one-click unsubscribe."}
  canonical={canonical}
  ogImage="/images/DSC07143_DxO-3-scaled.jpg"
  popup={false}
>
  <Header solid />

  <main>
    <section class="contact-hero">
      <div class="site-shell">
        <p class="contact-hero__eyebrow">{"Newsletter"}</p>
        <h1>{"Follow the"}<br /><em>{"next journeys."}</em></h1>
        <p class="contact-hero__lead">
          {"One or two letters each season, with upcoming departures and newly available places."}
        </p>
      </div>
    </section>

    <section class="contact-main">
      <div class="site-shell contact-grid newsletter-grid">
        <div class="contact-copy">
          <p class="contact-copy__eyebrow">{"Ski journeys, from village to village"}</p>
          <h2>{"A few letters."}<br /><em>{"Just the essentials."}</em></h2>
          <p>
            {"Les Grands Raids à Ski offers traverses through mountain ranges, often in places rarely visited on skis. We travel from one village to the next, stay with local people, and sometimes sleep in a shelter or a tent."}
          </p>
          <p>
            {"When you subscribe, you’ll receive a welcome message, followed by dates for upcoming trips as soon as they are confirmed. Unsubscribe with one click, at any time."}
          </p>
        </div>

        <div class="contact-panel">
          <form class="contact-form newsletter-form" action={NEWSLETTER_ENDPOINT} method="POST" novalidate>
            <label>{"Email"}<input type="email" name="EMAIL" placeholder={"Your email address"} autocomplete="email" required /></label>
            <input type="hidden" name="locale" value={lang} />
            <input type="hidden" name="html_type" value="simple" />
            <div class="newsletter-form__trap" aria-hidden="true"><input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" /></div>
            <button type="submit">{"Subscribe"}</button>
            <p class="newsletter-form__error" role="alert" hidden></p>
          </form>
          <p class="newsletter-form__thanks" role="status" tabindex="-1" hidden>
            {"Thank you, you’re on the list. A welcome message is on its way to your inbox. In Gmail, it often lands in Promotions: move it to Primary so you don’t miss a letter."}
          </p>

          <hr class="contact-panel__divider" />

          <a class="contact-panel__whatsapp" href={contact.whatsappCommunityUrl} target="_blank" rel="noopener noreferrer">
            <span class="contact-panel__whatsapp-eyebrow">{"Or directly on WhatsApp"}</span>
            <span class="contact-panel__whatsapp-row">
              <strong>{"Join the community"}</strong>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell site-footer__grid">
      <div>
        <p class="eyebrow">LES GRANDS RAIDS À SKI</p>
        <p class="site-footer__statement">{"Explore · improvise · meet · ski."}</p>
      </div>

      <div class="site-footer__links">
        <a href="https://wa.me/33689295826">{"WhatsApp · +33 6 89 29 58 26"}</a>
        <a href="https://www.instagram.com/lesgrandsraidsaski/">{"Instagram"}</a>
        <a href="https://www.facebook.com/yannborgnet/">{"Facebook"}</a>
      </div>
    </div>

    <SponsorStrip />

    <div class="site-shell site-footer__bottom">
      <a href={localizedHref(lang, "/yann-borgnet-guide-haute-montagne/")}>{"Yann Borgnet · IFMGA mountain guide"}</a>
      <span>© 2026</span>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Champ anti-robot de Brevo : hors de vue. Le conteneur rogne l'input, que
     les styles .contact-form input étirent à 100 % de largeur (débordement
     horizontal de toute la page sinon). */
  .newsletter-form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .newsletter-form__error {
    margin: 0;
    font-size: 14px;
    color: #a3261b;
  }
  .newsletter-form__thanks {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.6vw, 23px);
    font-weight: 300;
    line-height: 1.5;
  }
  .newsletter-form__thanks:focus {
    outline: none;
  }
  /* Sur mobile (l'essentiel du trafic venu de Facebook), le formulaire passe
     avant le texte pour être visible sans défiler. */
  @media (max-width: 900px) {
    .newsletter-grid .contact-panel {
      order: -1;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>(".newsletter-form");
  const err = document.querySelector<HTMLElement>(".newsletter-form__error");
  const thanks = document.querySelector<HTMLElement>(".newsletter-form__thanks");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!err || !thanks) return;
    const email = form.querySelector<HTMLInputElement>("input[name=EMAIL]")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    err.hidden = true;
    if (!email.value.trim() || !email.checkValidity()) {
      err.textContent = "Please enter a valid email address.";
      err.hidden = false;
      email.focus();
      return;
    }
    if (form.querySelector<HTMLInputElement>("input[name=email_address_check]")?.value) return;
    const label = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Sending…";
    const url = form.action + (form.action.includes("?") ? "&" : "?") + "isAjax=1";
    try {
      try {
        const res = await fetch(url, { method: "POST", body: new FormData(form) });
        const data = await res.json().catch(() => null);
        if (!(data ? data.success === true : res.ok)) throw new Error("brevo");
      } catch (e) {
        if (!(e instanceof TypeError)) throw e;
        // Lecture bloquée (CORS) : on renvoie en no-cors, réponse opaque = succès.
        await fetch(url, { method: "POST", body: new FormData(form), mode: "no-cors" });
      }
      // Inscrit : le pop-up ne se montrera plus sur le reste du site.
      try {
        localStorage.setItem("lgrs-contact-popup", JSON.stringify({ done: true }));
      } catch {}
      (window as any).umami?.track?.("newsletter-inscription");
      form.hidden = true;
      thanks.hidden = false;
      thanks.focus();
    } catch {
      err.textContent = "Your subscription could not be completed. Please try again shortly.";
      err.hidden = false;
      btn.disabled = false;
      btn.textContent = label;
    }
  });
</script>
