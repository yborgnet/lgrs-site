---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import "../../styles/contact.css";
import { withBase } from "../../lib/url";

const canonical = "https://lesgrandsraidsaski.com/contact/";

/**
 * Contenu repris tel quel de la page WordPress live
 * https://lesgrandsraidsaski.com/contact/ : hero, bloc "Un projet sur
 * mesure", formulaire (mêmes champs/libellés/bouton) et CTA WhatsApp.
 * Charte visuelle du nouveau site (tokens de global.css, mêmes patterns
 * d'eyebrow/h1/CTA que /philosophie/ et les pages voyage) plutôt que le
 * CSS WordPress d'origine.
 *
 * Le formulaire poste vers Formspree (https://formspree.io) plutôt que
 * vers WordPress : un site statique GitHub Pages ne peut pas traiter
 * lui-même un envoi de formulaire, et poster vers wp-admin/admin-post.php
 * dépendait d'un nonce WordPress qui expire au bout de ~24h.
 */
const FORMSPREE_ENDPOINT = "https://formspree.io/f/mkjgrpgv";
---

<BaseLayout
  title="Contact | Les Grands Raids à Ski"
  description="Un voyage déjà au programme, une traversée à imaginer ou simplement un pays ou un massif qui vous fait rêver : contactez Yann Borgnet pour en discuter directement."
  canonical={canonical}
>
  <Header solid />

  <main>
    <section class="contact-hero">
      <div class="site-shell">
        <p class="contact-hero__eyebrow">Contact</p>
        <h1>Parler d'un<br /><em>projet.</em></h1>
        <p class="contact-hero__lead">
          Un voyage déjà au programme, une traversée à imaginer ou simplement un pays ou un massif qui vous fait
          rêver, le plus simple est d'en discuter directement.
        </p>
      </div>
    </section>

    <section class="contact-main">
      <div class="site-shell contact-grid">
        <div class="contact-copy">
          <p class="contact-copy__eyebrow">Un projet sur mesure</p>
          <h2>Partir d'une envie.<br /><em>Tracer la ligne ensuite.</em></h2>
          <p>
            Vous avez une destination en tête, une période disponible ou simplement l'envie d'une itinérance à ski
            différente des voyages déjà programmés ? Écrivez-moi avec quelques éléments : nombre de personnes, dates
            possibles, niveau du groupe et terrain recherché.
          </p>
          <p>Je vous répondrai pour voir ce qu'il est possible de construire ensemble.</p>
        </div>

        <div class="contact-panel">
          <form class="contact-form" action={FORMSPREE_ENDPOINT} method="POST">
            <label>Nom<input type="text" name="name" required /></label>
            <label>E-mail<input type="email" name="email" required /></label>
            <label>Votre projet<textarea name="message" rows="7" required></textarea></label>

            <button type="submit">Envoyer le message</button>
          </form>

          <hr class="contact-panel__divider" />

          <a class="contact-panel__whatsapp" href="https://wa.me/33689295826" target="_blank" rel="noopener">
            <span class="contact-panel__whatsapp-eyebrow">Ou par WhatsApp</span>
            <span class="contact-panel__whatsapp-row">
              <strong>M'écrire directement</strong>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell site-footer__grid">
      <div>
        <p class="eyebrow">LES GRANDS RAIDS À SKI</p>
        <p class="site-footer__statement">Explorer · improviser · rencontrer · skier.</p>
      </div>

      <div class="site-footer__links">
        <a href="https://wa.me/33689295826">WhatsApp · +33 6 89 29 58 26</a>
        <a href="https://www.instagram.com/yannborgnet/">Instagram</a>
        <a href="https://www.facebook.com/yannborgnet/">Facebook</a>
      </div>
    </div>

    <div class="site-shell site-footer__bottom">
      <a href={withBase("/yann-borgnet-guide-haute-montagne/")}>Yann Borgnet · Guide de haute montagne UIAGM</a>
      <span>© 2026</span>
    </div>
  </footer>
</BaseLayout>
