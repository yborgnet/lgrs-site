        </div>

        <a class="raid-cta" href={withBase("/prochains-voyages/")}>Voir les prochains voyages →</a>
      </div>
    </section>

    <!-- SECTION 11 — FAQ -->
    <section class="raid-section raid-section--paper raid-section--faq">
