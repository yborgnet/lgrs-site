---
import { getLang, localizedHref } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);
import SponsorStrip from "../../components/shared/SponsorStrip.astro";
import ContactStrip from "../../components/shared/ContactStrip.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import PhotoSlot from "../../components/editorial/PhotoSlot.astro";
import "../../styles/home-projets.css";
import { withBase } from "../../lib/url";
import { carnets } from "../../data/carnets/it/index";

const canonical = "https://lesgrandsraidsaski.com/it/";

// Segments de la traversée des Alpes : uniquement les carnets publiés de la zone
// "traversee-des-alpes" (src/data/carnets), intitulés et URLs issus des données.
const segmentsAlpins = carnets
  .filter((c) => c.zones.includes("traversee-des-alpes"))
  .map((c, i) => ({ slug: c.slug, i, name: (c.subtitle ?? c.title).replace(" : ", " · ") }))
  .sort((a, b) => a.name.localeCompare(b.name, lang, { numeric: true }) || a.i - b.i);
---

<BaseLayout
  title={"Viaggi e traversate di scialpinismo | Yann Borgnet"}
  description={"Viaggi di scialpinismo in itineranza, sulle Alpi e sulle montagne del mondo, con Yann Borgnet, guida alpina UIAGM."}
  canonical={canonical}
  ogImage="/images/DSC07143_DxO-3-scaled.jpg"
>
  <Header />

  <main>
    <section class="hero">
      <img
        class="hero__image"
        src={withBase("/images/DSC07143_DxO-3-scaled.jpg")}
        alt={"Una lunga traversata con gli sci in montagna"}
      />

      <div class="hero__veil"></div>

      <div class="site-shell hero__content">
        <div class="hero__kicker">{"ALPI · MONTAGNE DEL MONDO"}</div>

        <h1>
          LES GRANDS<br class="hero-break--desktop" />{" "}
          RAIDS<br class="hero-break--mobile" />{" "}
          <em>À SKI</em>
        </h1>

        <p class="hero__tagline">
          {"Esplorare · improvvisare · incontrare · sciare"}
        </p>
      </div>
    </section>

    <section class="intro-section home-screen" id="philosophie">
      <div class="site-shell intro-grid">
        <div>
          <p class="eyebrow eyebrow--warm">{"UN CERTO MODO DI INTENDERE IL VIAGGIO"}</p>
          <h2>{"Tracciare linee"}<br /><em>{"orizzontali."}</em></h2>
        </div>

        <div class="intro-copy">
          <p class="intro-copy__lead">
            {"L’itineranza dà forma al mio modo di viaggiare con gli sci e al mio rapporto con la montagna."}
          </p>

          <p>
            {"Di valle in valle, di villaggio in villaggio, di bivacco in bivacco: ogni itinerario viene preparato con precisione, lasciando poi uno spazio reale al terreno, alla neve e agli incontri."}
          </p>

          <a class="home-link" href={localizedHref(lang, "/philosophie/")}>
            {"Leggi la filosofia"} <span>↗</span>
          </a>
        </div>
      </div>
    </section>


    <section class="voyages-section home-screen" id="voyages">

      <div class="site-shell voyages-heading">
        <div>
          <p class="eyebrow">{"INVERNO 2027"}</p>
          <h2>{"Una stagione"}<br /><em>{"da scrivere."}</em></h2>
        </div>

        <p class="voyages-heading__intro">
          {"Cinque viaggi costruiti intorno all’itineranza, all’esplorazione e a ciò che il terreno ci permetterà di scrivere."}
        </p>
      </div>


      <div class="site-shell voyages-grid">

        <div class="voyages-photo">
          <img
            src={withBase("/images/DSC02181-1024x684.jpg")}
            alt={"Terreno per una lunga traversata scialpinistica"}
            loading="lazy"
          />

          <div class="voyages-photo__caption">
            <span>2027</span>
            <p>{"Cinque itineranze."}<br />{"Una stagione da scrivere."}</p>
          </div>
        </div>


        <div class="voyages-list">

          <a class="voyage-row" href={localizedHref(lang, "/ski-randonnee-georgie-petit-caucase-2027/")}>
            <span class="voyage-date">{"17 — 26 GEN"}</span>
            <span class="voyage-text">
              <strong>{"GEORGIA › PICCOLO CAUCASO"}</strong>
              <small>{"Dai vulcani del Javakheti alle nevi profonde dell’Adjara e della Guria."}</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={localizedHref(lang, "/ski-randonnee-ouzbekistan-traversee-baysun/")}>
            <span class="voyage-date">{"04 — 13 FEB"}</span>
            <span class="voyage-text">
              <strong>{"UZBEKISTAN › HISSAR"}</strong>
              <small>{"Esplorazione, poi itineranza di villaggio in villaggio."}</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={localizedHref(lang, "/ski-randonnee-armenie-sevan-aragats-2027/")}>
            <span class="voyage-date">{"20 FEB — 01 MAR"}</span>
            <span class="voyage-text">
              <strong>{"ARMENIA › SEVAN → ARAGATS"}</strong>
              <small>{"Foreste, altipiani e cime vulcaniche."}</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={localizedHref(lang, "/raid-ski-mediterraneen-2027/")}>
            <span class="voyage-date">{"06 — 14 MAR"}</span>
            <span class="voyage-text">
              <strong>{"TRAVERSATA MEDITERRANEA"}</strong>
              <small>{"Sarà l’inverno a decidere la destinazione."}</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={localizedHref(lang, "/ski-randonnee-tadjikistan-zeravshan-2027/")}>
            <span class="voyage-date">{"21 — 29 MAR"}</span>
            <span class="voyage-text">
              <strong>{"TAGIKISTAN › ZERAVSHAN"}</strong>
              <small>{"La traversata più impegnativa della stagione."}</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>


          <div class="voyages-actions">
            <a class="voyages-button" href={localizedHref(lang, "/prochains-voyages/")}>
              {"Scopri i viaggi del 2027"}
            </a>

            <a class="home-link" href="https://wa.me/33689295826">
              {"Richiedi una scheda tecnica →"}
            </a>
          </div>

        </div>
      </div>

    </section>


    <section class="manifesto-section">

      <div class="photo-break">
        <img
        src={withBase("/images/Traversées-kosovardes.png")}
        alt={"Una traversata con gli sci nei Balcani"}
        loading="lazy"
      />

      <div class="photo-break__overlay"></div>

      <div class="site-shell photo-break__content">
        <p class="eyebrow">{"PREPARARE · IMPROVVISARE · COLLEGARE"}</p>
        <blockquote>
          {"«Preparare con cura, per poter poi improvvisare.»"}
        </blockquote>
      </div>
      </div>

      <div class="method-section">

      <div class="site-shell method-grid">

        <article class="method-card">
          <span>01</span>
          <h3>{"Preparare"}</h3>
          <p>
            {"Carte, immagini aeree, scambi con le persone del posto, logistica: costruire una base solida prima della partenza."}
          </p>
        </article>

        <article class="method-card">
          <span>02</span>
          <h3>{"Improvvisare"}</h3>
          <p>
            {"Accettare che il gruppo, la neve, il meteo e il terreno compongano l’altra metà della storia."}
          </p>
        </article>

        <article class="method-card">
          <span>03</span>
          <h3>{"Collegare"}</h3>
          <p>
            {"Valli, villaggi, bivacchi e abitanti. Attraversare, anziché collezionare cime."}
          </p>
        </article>

      </div>

      </div>

    </section>


    <section class="carnets-section home-screen" id="carnets">

      <div class="site-shell section-heading-row">

        <div>
          <p class="eyebrow">{"DIARI SUL CAMPO"}</p>
          <h2>
            {"I viaggi passati"}<br />
            <em>{"lasciano tracce."}</em>
          </h2>
        </div>

        <a class="home-link" href={localizedHref(lang, "/carnets-de-voyage-ski/")}>
          {"Tutti i racconti →"}
        </a>

      </div>


      <div class="site-shell story-grid">

        <article class="story-card">
          <a class="story-card__image" href={localizedHref(lang, "/bernina-tour-massif-ski-randonnee/")}>
            <img
              src={withBase("/images/bernina-ski-randonnee-01-panorama-piz-palu-glaciers-1024x684.jpg")}
              alt={"Bernina — Giro del massiccio"}
              loading="lazy"
            />
          </a>
          <p class="eyebrow">{"SET 2026"}</p>
          <h3>{"BERNINA — GIRO DEL MASSICCIO"}</h3>
          <p>
            {"Giro scialpinistico del massiccio del Bernina, tra ghiacciai, morene, rifugi e bivacchi d’alta quota."}
          </p>
        </article>


        <article class="story-card">
          <a class="story-card__image" href={localizedHref(lang, "/traversee-ski-argentera-mercantour/")}>
            <img
              src={withBase("/photos/Argentera/traversee-ski-mercantour-argentera-panorama.jpg")}
              alt={"Argentera — Mercantour"}
              loading="lazy"
            />
          </a>
          <p class="eyebrow">{"SET 2026"}</p>
          <h3>{"ARGENTERA — MERCANTOUR"}</h3>
          <p>
            {"Una traversata transalpina nel segno del vento, dei lupi e dell’itineranza."}
          </p>
        </article>


        <article class="story-card">
          <a class="story-card__image" href={localizedHref(lang, "/alpes-ligures-traversee-ski-randonnee/")}>
            <img
              src={withBase("/images/alpes-ligures-j3-cima-degli-arpetti-01-1024x684.jpg")}
              alt={"Alpi Liguri"}
              loading="lazy"
            />
          </a>
          <p class="eyebrow">{"SET 2026"}</p>
          <h3>{"ALPI LIGURI"}</h3>
          <p>
            {"Una traversata con gli sci attraverso le valli e i villaggi delle Alpi Liguri."}
          </p>
        </article>

      </div>

    </section>


    <section class="projets-section" id="projets">
      <div class="site-shell">

        <div class="projets-head">
          <p class="eyebrow">{"PROGETTI"}</p>
          <h2>{"Attraversare, indagare,"} <em>{"raccontare."}</em></h2>
          <p class="projets-head__intro">
            {"Progetti in cui l’itineranza diventa anche un modo per esplorare, documentare e raccontare i territori di montagna."}
          </p>
        </div>

        <article class="projet">
          <div class="projet__media">
            <PhotoSlot ratio="3 / 2" tone="dark" label="" src="/photos/Raid anthropologique Queyras/raid-anthropologique-queyras-ski-randonnee-cretes.jpg" alt={"Uno scialpinista su un pendio di fronte alle creste rocciose del Queyras"} />
          </div>
          <div class="projet__body">
            <p class="eyebrow">{"QUEYRAS · 2022"}</p>
            <h3>
              <a class="projet__link" href={localizedHref(lang, "/transition-raid-anthropologique-queyras/")}>
                {"TRANSITION — UN VIAGGIO ANTROPOLOGICO CON GLI SCI"}
              </a>
            </h3>
            <p class="projet__text">
              {"Cinque giorni con gli sci per far dialogare un territorio, i suoi abitanti e le scienze sociali, all’incrocio tra il mestiere di guida e la ricerca in geografia."}
            </p>
            <span class="projet__cta">{"Scopri il progetto →"}</span>
          </div>
        </article>

        <div class="traversees">
          <h3 class="traversees__title">{"TRAVERSATE DELLE ALPI"}</h3>

          <article class="projet projet--reverse traversees__part">
            <div class="projet__media">
              <PhotoSlot ratio="3 / 2" tone="dark" label="" src="/photos/Alpine Line/alpine-line-alpinisme-arete-neige.jpg" alt={"Un alpinista in cordata su una cresta di neve sopra un mare di nuvole"} />
            </div>
            <div class="projet__body">
              <p class="eyebrow">2015</p>
              <h4>{"ALPINE LINE"}</h4>
              <p class="projet__text">
                {"Una lunga traversata delle Alpi senza mezzi motorizzati, realizzata con Yoann Joly: dal Monte Cinto, in Corsica, al Triglav, in Slovenia. Per 161 giorni abbiamo collegato i massicci a piedi, in bicicletta, con gli sci da scialpinismo e da fondo, in parapendio, a vela e in kayak. Una traversata amatoriale, lunga e aperta, fatta di itineranza, alpinismo e imprevisti."}
              </p>
              <a class="projet__cta" href={localizedHref(lang, "/le-film/")}>{"Guarda il film Alpine Line →"}</a>
            </div>
          </article>

          <div class="traversees__guidees">
            <div class="traversees__intro">
              <p class="eyebrow">{"DAL 2024"}</p>
              <h4>{"UNA LUNGA TRAVERSATA GUIDATA DELLE ALPI"}</h4>
              <p class="projet__text">
                {"Dal 2024 ho cominciato una seconda traversata delle Alpi, questa volta come guida e soltanto con gli sci da scialpinismo. Ogni anno avanziamo di un centinaio di chilometri, attraversando i massicci secondo i desideri e le condizioni."}
              </p>
            </div>

            <div class="traversees__liste">
              <ul>
                {
                  segmentsAlpins.map((seg) => (
                    <li>
                      <a href={localizedHref(lang, `/${seg.slug}/`)}>
                        <span class="traversees__nom">{seg.name}</span>
                        <span class="traversees__lire">{"Leggi il diario →"}</span>
                      </a>
                    </li>
                  ))
                }
                {/* Segment #4 (Queyras) : pas encore de page carnet → non affiché. À ajouter quand elle existera. */}
              </ul>
              <a class="projet__cta" href={localizedHref(lang, "/carnets-de-voyage-ski/")}>
                {"Leggi tutti i diari delle traversate →"}
              </a>
            </div>
          </div>
        </div>

        <article class="projet projet--skimed">
          <div class="projet__media">
            <PhotoSlot ratio="3 / 2" tone="dark" label="" src="/photos/Argentera/ski-randonnee-argentera-vue-mediterranee.jpg" alt={"Scialpinisti nelle Alpi Marittime, con il Mediterraneo all’orizzonte"} />
          </div>
          <div class="projet__body">
            <p class="eyebrow">{"MONTAGNE DI FRONTE AL MARE"}</p>
            <h3>
              <a class="projet__link" href={localizedHref(lang, "/raid-ski-mediterraneen-2027/")}>
                {"SKI MED"}
              </a>
            </h3>
            <p class="projet__text">
              {"Dall’Alto Atlante marocchino alle montagne greche del Pindo, dalle Alpi Liguri ai massicci della Turchia meridionale: itineranze con gli sci nel cuore delle montagne mediterranee. Un altro modo di vivere l’inverno, dove la neve è rara e contrasta con un orizzonte che sembra infinito."}
            </p>
            <span class="projet__cta">{"Scopri le traversate scialpinistiche mediterranee →"}</span>
          </div>
        </article>

      </div>
    </section>

    <section class="about-section home-screen">

      <div class="site-shell about-grid">

        <div class="about-photo">
          <img
            src={withBase("/images/fba56613-bfe2-4d63-ab54-90bd71f10e09-1-819x1024.png")}
            alt={"Yann Borgnet, guida alpina UIAGM"}
            loading="lazy"
          />
        </div>

        <div class="about-copy">

          <p class="eyebrow">
            {"GUIDA ALPINA · GEOGRAFO"}
          </p>

          <h2>
            {"Yann"}<br />
            <em>{"Borgnet."}</em>
          </h2>

          <p class="about-copy__lead">
            {"Originario di Annecy, guida alpina UIAGM, docente all’ENSA e dottore di ricerca in geografia."}
          </p>

          <p>
            {"Le mie ricerche sul futuro del turismo alpino hanno alimentato un interesse per la montagna abitata: quella che si attraversa e che si incontra."}
          </p>

          <a class="home-link" href={localizedHref(lang, "/yann-borgnet-guide-haute-montagne/")}>
            {"Scopri il mio percorso →"}
          </a>

        </div>
      </div>

    </section>
  </main>

  <ContactStrip />

  <footer class="site-footer">

    <div class="site-shell site-footer__grid">

      <div>
        <p class="eyebrow">LES GRANDS RAIDS À SKI</p>
        <p class="site-footer__statement">
          {"Esplorare · improvvisare · incontrare · sciare."}
        </p>
      </div>

      <div class="site-footer__links">
        <a href="https://wa.me/33689295826">{"WhatsApp · +33 6 89 29 58 26"}</a>
        <a href="https://www.instagram.com/lesgrandsraidsaski/">{"Instagram"}</a>
        <a href="https://www.facebook.com/yannborgnet/">{"Facebook"}</a>
      </div>

    </div>

    <SponsorStrip />

    <div class="site-shell site-footer__bottom">
      <a href={localizedHref(lang, "/yann-borgnet-guide-haute-montagne/")}>{"Yann Borgnet · Guida alpina UIAGM"}</a>
      <span>© 2026</span>
    </div>

  </footer>

</BaseLayout>
