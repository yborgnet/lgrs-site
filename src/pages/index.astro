---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PhotoSlot from "../components/editorial/PhotoSlot.astro";
import "../styles/home-projets.css";
import { withBase } from "../lib/url";
import { carnets } from "../data/carnets/index";

const canonical = "https://lesgrandsraidsaski.com/";

// Segments de la traversée des Alpes : uniquement les carnets publiés de la zone
// "traversee-des-alpes" (src/data/carnets), intitulés et URLs issus des données.
const segmentsAlpins = carnets
  .filter((c) => c.zones.includes("traversee-des-alpes"))
  .map((c, i) => ({ slug: c.slug, i, name: (c.subtitle ?? c.title).replace(" : ", " · ") }))
  .sort((a, b) => a.name.localeCompare(b.name, "fr", { numeric: true }) || a.i - b.i);
---

<BaseLayout
  title="Voyages & raids à ski de randonnée | Yann Borgnet"
  description="Voyages et raids à ski de randonnée en itinérance, dans les Alpes et les montagnes du monde, avec Yann Borgnet, guide de haute montagne UIAGM."
  canonical={canonical}
  ogImage="/images/DSC07143_DxO-3-scaled.jpg"
>
  <Header />

  <main>
    <section class="hero">
      <img
        class="hero__image"
        src={withBase("/images/DSC07143_DxO-3-scaled.jpg")}
        alt="Grand raid à ski dans les montagnes"
      />

      <div class="hero__veil"></div>

      <div class="site-shell hero__content">
        <div class="hero__kicker">ALPES · MONTAGNES DU MONDE</div>

        <h1>
          LES GRANDS<br class="hero-break--desktop" />{" "}
          RAIDS<br class="hero-break--mobile" />{" "}
          <em>À SKI</em>
        </h1>

        <p class="hero__tagline">
          Explorer · improviser · rencontrer · skier
        </p>
      </div>
    </section>

    <section class="intro-section home-screen" id="philosophie">
      <div class="site-shell intro-grid">
        <div>
          <p class="eyebrow eyebrow--warm">UNE CERTAINE IDÉE DU VOYAGE</p>
          <h2>Tracer des lignes<br /><em>horizontales.</em></h2>
        </div>

        <div class="intro-copy">
          <p class="intro-copy__lead">
            L’itinérance structure ma manière de voyager à ski de randonnée et mon rapport à la montagne.
          </p>

          <p>
            De vallée en vallée, de village en village, de bivouac en bivouac :
            chaque itinéraire est préparé avec précision, puis laisse une place réelle
            au terrain, à la neige et aux rencontres.
          </p>

          <a class="home-link" href={withBase("/philosophie/")}>
            Lire la philosophie <span>↗</span>
          </a>
        </div>
      </div>
    </section>


    <section class="voyages-section home-screen" id="voyages">

      <div class="site-shell voyages-heading">
        <div>
          <p class="eyebrow">HIVER 2027</p>
          <h2>Une saison<br /><em>à écrire.</em></h2>
        </div>

        <p class="voyages-heading__intro">
          Cinq voyages construits autour de l’itinérance, de l’exploration
          et de ce que le terrain voudra bien nous laisser écrire.
        </p>
      </div>


      <div class="site-shell voyages-grid">

        <div class="voyages-photo">
          <img
            src={withBase("/images/DSC02181-1024x684.jpg")}
            alt="Terrain de grand raid à ski"
            loading="lazy"
          />

          <div class="voyages-photo__caption">
            <span>2027</span>
            <p>Cinq itinérances.<br />Une saison à écrire.</p>
          </div>
        </div>


        <div class="voyages-list">

          <a class="voyage-row" href={withBase("/ski-randonnee-georgie-petit-caucase-2027/")}>
            <span class="voyage-date">17 — 26 JAN</span>
            <span class="voyage-text">
              <strong>GÉORGIE › PETIT CAUCASE</strong>
              <small>Des volcans du Javakheti aux neiges profondes d’Adjarie et de Gourie.</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={withBase("/ski-randonnee-ouzbekistan-traversee-baysun/")}>
            <span class="voyage-date">04 — 13 FÉV</span>
            <span class="voyage-text">
              <strong>OUZBÉKISTAN › HISSAR</strong>
              <small>Exploration puis itinérance de village en village.</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={withBase("/ski-randonnee-armenie-sevan-aragats-2027/")}>
            <span class="voyage-date">20 FÉV — 01 MAR</span>
            <span class="voyage-text">
              <strong>ARMÉNIE › SEVAN → ARAGATS</strong>
              <small>Forêts, hauts plateaux et sommets volcaniques.</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={withBase("/raid-ski-mediterraneen-2027/")}>
            <span class="voyage-date">06 — 14 MAR</span>
            <span class="voyage-text">
              <strong>RAID MÉDITERRANÉEN</strong>
              <small>La destination se décidera avec l’hiver.</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>

          <a class="voyage-row" href={withBase("/ski-randonnee-tadjikistan-zeravshan-2027/")}>
            <span class="voyage-date">21 — 29 MAR</span>
            <span class="voyage-text">
              <strong>TADJIKISTAN › ZERAVSHAN</strong>
              <small>La traversée la plus engagée de la saison.</small>
            </span>
            <span class="voyage-arrow">↗</span>
          </a>


          <div class="voyages-actions">
            <a class="voyages-button" href={withBase("/prochains-voyages/")}>
              Voir les voyages 2027
            </a>

            <a class="home-link" href="https://wa.me/33689295826">
              Recevoir une fiche technique →
            </a>
          </div>

        </div>
      </div>

    </section>


    <section class="manifesto-section">

      <div class="photo-break">
        <img
        src={withBase("/images/Traversées-kosovardes.png")}
        alt="Traversée à ski dans les Balkans"
        loading="lazy"
      />

      <div class="photo-break__overlay"></div>

      <div class="site-shell photo-break__content">
        <p class="eyebrow">PRÉPARER · IMPROVISER · RELIER</p>
        <blockquote>
          « Préparer minutieusement pour pouvoir ensuite improviser. »
        </blockquote>
      </div>
      </div>

      <div class="method-section">

      <div class="site-shell method-grid">

        <article class="method-card">
          <span>01</span>
          <h3>Préparer</h3>
          <p>
            Cartes, images aériennes, échanges locaux, logistique :
            poser un cadre solide avant le départ.
          </p>
        </article>

        <article class="method-card">
          <span>02</span>
          <h3>Improviser</h3>
          <p>
            Accepter que le groupe, la neige, la météo et le terrain
            composent l’autre moitié de l’histoire.
          </p>
        </article>

        <article class="method-card">
          <span>03</span>
          <h3>Relier</h3>
          <p>
            Vallées, villages, bivouacs et habitants.
            Traverser plutôt que collectionner des sommets.
          </p>
        </article>

      </div>

      </div>

    </section>


    <section class="carnets-section home-screen" id="carnets">

      <div class="site-shell section-heading-row">

        <div>
          <p class="eyebrow">CARNETS DE TERRAIN</p>
          <h2>
            Les voyages passés<br />
            <em>laissent des traces.</em>
          </h2>
        </div>

        <a class="home-link" href={withBase("/carnets-de-voyage-ski/")}>
          Tous les récits →
        </a>

      </div>


      <div class="site-shell story-grid">

        <article class="story-card">
          <a class="story-card__image" href={withBase("/bernina-tour-massif-ski-randonnee/")}>
            <img
              src={withBase("/images/bernina-ski-randonnee-01-panorama-piz-palu-glaciers-1024x684.jpg")}
              alt="Bernina — Tour du massif"
              loading="lazy"
            />
          </a>
          <p class="eyebrow">SEP 2026</p>
          <h3>BERNINA — TOUR DU MASSIF</h3>
          <p>
            Tour du massif de la Bernina à ski de randonnée,
            entre glaciers, moraines, refuges et bivouacs d’altitude.
          </p>
        </article>


        <article class="story-card">
          <a class="story-card__image" href={withBase("/traversee-ski-argentera-mercantour/")}>
            <img
              src={withBase("/photos/Argentera/traversee-ski-mercantour-argentera-panorama.jpg")}
              alt="Argentera — Mercantour"
              loading="lazy"
            />
          </a>
          <p class="eyebrow">SEP 2026</p>
          <h3>ARGENTERA — MERCANTOUR</h3>
          <p>
            Une traversée transalpine sous le signe du vent,
            des loups et de l’itinérance.
          </p>
        </article>


        <article class="story-card">
          <a class="story-card__image" href={withBase("/alpes-ligures-traversee-ski-randonnee/")}>
            <img
              src={withBase("/images/alpes-ligures-j3-cima-degli-arpetti-01-1024x684.jpg")}
              alt="Alpes Ligures"
              loading="lazy"
            />
          </a>
          <p class="eyebrow">SEP 2026</p>
          <h3>ALPES LIGURES</h3>
          <p>
            Une traversée à ski au fil des vallées et des villages
            des Alpes ligures.
          </p>
        </article>

      </div>

    </section>


    <section class="projets-section" id="projets">
      <div class="site-shell">

        <div class="projets-head">
          <p class="eyebrow">PROJETS</p>
          <h2>Traverser, enquêter, <em>raconter.</em></h2>
          <p class="projets-head__intro">
            Des projets où l’itinérance devient aussi une manière d’explorer, de documenter et de mettre
            en récit les territoires de montagne.
          </p>
        </div>

        <article class="projet">
          <div class="projet__media">
            <PhotoSlot ratio="3 / 2" tone="dark" label="" src="/photos/Raid anthropologique Queyras/raid-anthropologique-queyras-ski-randonnee-cretes.jpg" alt="Skieur de randonnée sur une pente face aux crêtes rocheuses du Queyras" />
          </div>
          <div class="projet__body">
            <p class="eyebrow">QUEYRAS · 2022</p>
            <h3>
              <a class="projet__link" href={withBase("/transition-raid-anthropologique-queyras/")}>
                TRANSITION — UN RAID ANTHROPOLOGIQUE
              </a>
            </h3>
            <p class="projet__text">
              Cinq jours à skis pour mettre en dialogue un territoire, ses habitants et les sciences
              sociales, à la croisée du métier de guide et d’un travail de recherche en géographie.
            </p>
            <span class="projet__cta">Découvrir le projet →</span>
          </div>
        </article>

        <div class="traversees">
          <h3 class="traversees__title">TRAVERSÉES DES ALPES</h3>

          <article class="projet projet--reverse traversees__part">
            <div class="projet__media">
              <PhotoSlot ratio="3 / 2" tone="dark" label="" src="/photos/Alpine Line/alpine-line-alpinisme-arete-neige.jpg" alt="Alpiniste encordé sur une arête de neige au-dessus d’une mer de nuages" />
            </div>
            <div class="projet__body">
              <p class="eyebrow">2015</p>
              <h4>ALPINE LINE</h4>
              <p class="projet__text">
                Une grande traversée des Alpes sans moyens motorisés, réalisée avec Yoann Joly : du Monte
                Cinto, en Corse, au Triglav, en Slovénie. Pendant 161 jours, nous avons relié les massifs à
                pied, à vélo, à ski de randonnée, en ski nordique, en parapente, à la voile et en kayak. Une
                traversée amateur, longue et ouverte, faite d’itinérance, d’alpinisme et d’imprévus.
              </p>
              <a class="projet__cta" href={withBase("/le-film/")}>Voir le film Alpine Line →</a>
            </div>
          </article>

          <div class="traversees__guidees">
            <div class="traversees__intro">
              <p class="eyebrow">DEPUIS 2024</p>
              <h4>UNE GRANDE TRAVERSÉE DES ALPES GUIDÉE</h4>
              <p class="projet__text">
                Depuis 2024, j’ai recommencé une seconde traversée des Alpes, cette fois comme guide et uniquement à ski de
                randonnée. Chaque année, nous progressons d’une centaine de kilomètres, en cheminant dans les
                massifs au gré des envies et des conditions.
              </p>
            </div>

            <div class="traversees__liste">
              <ul>
                {
                  segmentsAlpins.map((seg) => (
                    <li>
                      <a href={withBase(`/${seg.slug}/`)}>
                        <span class="traversees__nom">{seg.name}</span>
                        <span class="traversees__lire">Lire le carnet →</span>
                      </a>
                    </li>
                  ))
                }
                {/* Segment #4 (Queyras) : pas encore de page carnet → non affiché. À ajouter quand elle existera. */}
              </ul>
              <a class="projet__cta" href={withBase("/carnets-de-voyage-ski/")}>
                Voir tous les carnets de traversée →
              </a>
            </div>
          </div>
        </div>

        <article class="projet projet--skimed">
          <div class="projet__media">
            <PhotoSlot ratio="3 / 2" tone="dark" label="" src="/photos/Argentera/ski-randonnee-argentera-vue-mediterranee.jpg" alt="Skieurs de randonnée dans les Alpes maritimes, avec la Méditerranée à l’horizon" />
          </div>
          <div class="projet__body">
            <p class="eyebrow">DES MONTAGNES FACE À LA MER</p>
            <h3>
              <a class="projet__link" href={withBase("/ski-mediterraneen/")}>
                SKI MED
              </a>
            </h3>
            <p class="projet__text">
              Du Haut Atlas marocain aux montagnes grecques du Pinde, des Alpes ligures italiennes aux
              massifs du sud de la Turquie, des itinérances à ski au cœur des montagnes méditerranéennes.
              Une autre manière de vivre l’hiver, là où la neige est rare et contraste avec l’horizon qui
              semble infini.
            </p>
            <span class="projet__cta">Découvrir les raids à ski méditerranéens →</span>
          </div>
        </article>

      </div>
    </section>

    <section class="about-section home-screen">

      <div class="site-shell about-grid">

        <div class="about-photo">
          <img
            src={withBase("/images/fba56613-bfe2-4d63-ab54-90bd71f10e09-1-819x1024.png")}
            alt="Yann Borgnet, guide de haute montagne UIAGM"
            loading="lazy"
          />
        </div>

        <div class="about-copy">

          <p class="eyebrow">
            GUIDE DE HAUTE MONTAGNE · GÉOGRAPHE
          </p>

          <h2>
            Yann<br />
            <em>Borgnet.</em>
          </h2>

          <p class="about-copy__lead">
            Originaire d’Annecy, guide UIAGM,
            professeur à l’ENSA et docteur en géographie.
          </p>

          <p>
            Mes recherches sur l’avenir du tourisme alpin ont nourri
            un intérêt pour la montagne habitée :
            celle que l’on traverse autant qu’on la rencontre.
          </p>

          <a class="home-link" href={withBase("/yann-borgnet-guide-haute-montagne/")}>
            Découvrir mon parcours →
          </a>

        </div>
      </div>

    </section>
  </main>

  <footer class="site-footer">

    <div class="site-shell site-footer__grid">

      <div>
        <p class="eyebrow">LES GRANDS RAIDS À SKI</p>
        <p class="site-footer__statement">
          Explorer · improviser · rencontrer · skier.
        </p>
      </div>

      <div class="site-footer__links">
        <a href="https://wa.me/33689295826">WhatsApp · +33 6 89 29 58 26</a>
        <a href="https://www.instagram.com/yannborgnet/">Instagram</a>
        <a href="https://www.facebook.com/yannborgnet/">Facebook</a>
      </div>

    </div>

    <div class="site-shell site-footer__bottom">
      <a href={withBase("/yann-borgnet-guide-haute-montagne/")}>Yann Borgnet · Guide de haute montagne UIAGM</a>
      <span>© 2026</span>
    </div>

  </footer>

</BaseLayout>
