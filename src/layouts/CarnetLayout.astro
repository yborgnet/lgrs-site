---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import CarnetHero from "../components/carnet/CarnetHero.astro";
import "../styles/info-grid.css";
import "../styles/carnet.css";
import type { Carnet } from "../data/carnets/types";

type Props = {
  carnet: Carnet;
};

const { carnet } = Astro.props;
const canonical = `https://lesgrandsraidsaski.com/${carnet.slug}/`;
---

<BaseLayout
  title={carnet.seo.title}
  description={carnet.seo.description}
  canonical={canonical}
  ogImage={carnet.seo.ogImage}
  ogType="article"
>
  <Header solid />

  <main class="carnet-single">
    <CarnetHero
      eyebrow={carnet.masthead.eyebrow}
      title={carnet.masthead.title}
      subtitle={carnet.masthead.subtitle}
      meta={carnet.masthead.meta}
    />

    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-shell site-footer__grid">
      <div>
        <p class="eyebrow">LES GRANDS RAIDS À SKI</p>
        <p class="site-footer__statement">Explorer · improviser · rencontrer · skier.</p>
      </div>

      <div class="site-footer__links">
        <a href="https://wa.me/33689295826">WhatsApp · +33 6 89 29 58 26</a>
        <a href="https://www.instagram.com/yannborgnet/">Instagram</a>
        <a href="https://www.facebook.com/yannborgnet/">Facebook</a>
      </div>
    </div>

    <div class="site-shell site-footer__bottom">
      <span>Yann Borgnet · Guide de haute montagne UIAGM</span>
      <span>© 2026</span>
    </div>
  </footer>
</BaseLayout>
